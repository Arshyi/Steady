{
  "name": "steady",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite --port 5173 --strictPort\" \"npm:server\"",
    "web": "vite --port 5173 --strictPort",
    "server": "node --env-file-if-exists=server/.env --watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "relay:mock": "node server/mock-relay.ts",
    "sim:device": "node server/device-sim.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "ws": "^8.22.1"
  }
}
