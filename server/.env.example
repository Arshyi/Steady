# Copy to server/.env and fill in. Log in once with: databricks auth login --host <DATABRICKS_HOST>
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=your-sql-warehouse-id
DATABRICKS_SCHEMA=workspace.steady
PORT=8787

# Staff login (Auth0). Leave AUTH0_DOMAIN / AUTH0_AUDIENCE empty to keep the dashboard open.
AUTH0_DOMAIN=your-tenant.ca.auth0.com
# The "Steady API" identifier. Must match VITE_AUTH0_AUDIENCE in .env.local.
AUTH0_AUDIENCE=https://steady-api
# The "Steady dashboard" (single page app) client ID
AUTH0_CLIENT_ID=
# The "Steady server" machine-to-machine app: lets the server create and invite accounts
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
